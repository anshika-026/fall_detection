# Copy to backend/.env and edit. Every value is optional; the defaults work for a first run.

APP_ENV=development
HOST=127.0.0.1
PORT=8830                      # SMC uses 8822 and MAINDV 8821: keep this module on its own port
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190

# First administrator (otherwise create it on the sign-in page the first time you open the app)
# ADMIN_EMAIL=ops@example.com
# ADMIN_PASSWORD=change-me-please

# Pose model and device
POSE_MODEL=yolov8n-pose.pt     # file in backend/models/ (yolov8s-pose.pt / yolov8m-pose.pt are more accurate, slower)
POSE_DEVICE=                   # empty = automatic; "cpu", or "0" for the first NVIDIA GPU
RUN_DETECTION=true             # false = API only (no models, no camera streaming)

# Storage
# DATA_DIR=backend/data
# EVIDENCE_DIR=backend/data/evidence
EVIDENCE_RETENTION_DAYS=30

LOG_LEVEL=INFO
